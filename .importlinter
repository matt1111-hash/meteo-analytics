# =============================================================================
# IMPORT-LINTER - Clean Architecture
# =============================================================================
# Ha nincs Clean Architecture struktúrád, töröld ezt a fájlt.
# =============================================================================

[importlinter]
# FONTOS: ez a könyvtár neve, NEM a Python package neve.
# Ha a struktúrád src/mypackage/, akkor: root_packages = mypackage
# és a layers containers-ben is mypackage legyen.
root_package = src
include_external_packages = true

# -----------------------------------------------------------------------------
# LAYER RULES
# presentation → api → analytics → data → infrastructure → application → domain
# Függőségek csak BEFELÉ!
# NOTE: adapters layer removed - does not exist in this project
# -----------------------------------------------------------------------------

[importlinter:contract:layers]
name = Clean Architecture Layers
type = layers
containers = src
layers =
    presentation
    api
    analytics
    data
    infrastructure
    application
    domain

# -----------------------------------------------------------------------------
# DOMAIN PURITY
# -----------------------------------------------------------------------------
[importlinter:contract:domain_purity]
name = Domain Independence
type = forbidden
source_modules = src.domain
forbidden_modules =
    fastapi
    flask
    django
    sqlalchemy
    sqlmodel
    requests
    httpx
    aiohttp
    celery
    redis
    boto3

# NOTE: pydantic ENGEDÉLYEZETT Value Object-ként

# -----------------------------------------------------------------------------
# APPLICATION ISOLATION
# -----------------------------------------------------------------------------
[importlinter:contract:application_isolation]
name = Application Layer Isolation
type = forbidden
source_modules = src.application
forbidden_modules =
    fastapi
    flask
    sqlalchemy

# -----------------------------------------------------------------------------
# DOMAIN PURITY ENHANCED - Inner Layer Independence
# -----------------------------------------------------------------------------
# Domain layer must not depend on any outer layer
[importlinter:contract:domain_purity_enhanced]
name = Domain Layer Purity (Inner Layers)
type = forbidden
source_modules = src.domain
forbidden_modules =
    src.data
    src.infrastructure
    src.api
    src.analytics
    src.presentation
    src.application

# -----------------------------------------------------------------------------
# PRESENTATION ISOLATION
# -----------------------------------------------------------------------------
# Presentation should not access outer layers directly
# NOTE: presentation MAY read domain.value_objects and domain.entities (stable contracts)
# Only domain.services and domain.ports calls should go through application layer
[importlinter:contract:presentation_isolation]
name = Presentation Layer Isolation
type = forbidden
source_modules = src.presentation
forbidden_modules =
    src.data
    src.infrastructure
