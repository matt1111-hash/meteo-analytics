# =============================================================================
# Quality Gate Configuration
# =============================================================================
# Helyezd ezt a projekt gyökerébe .quality_gate.conf néven
# Minden beállítás opcionális - ha nincs megadva, a default értékek érvényesek
# =============================================================================

# Coverage threshold (%)
# Default: 95
COVERAGE_THRESHOLD=95

# Pylint minimum score (0.0 - 10.0)
# Default: 9.0
PYLINT_MIN_SCORE=9.0

# Maximum sorok száma fájlonként
# Default: 250
MAX_FILE_LINES=250

# Source könyvtár (ha üres: auto-detect)
# Példák: "src", "lib", "app", "myproject"
SRC_DIR=""

# Test könyvtár (ha üres: auto-detect)
# Példák: "tests", "test", "spec"
TEST_DIR=""

# Git check kihagyása
# Default: false
SKIP_GIT=false

# Strict mód: warningok is FAIL-nak számítanak
# Default: false
STRICT_MODE=false

# Virtual environment keresési útvonalak
# Default: (".venv" "venv" ".env" "env")
VENV_PATHS=(".venv" "venv" ".env" "env")

# =============================================================================
# Projekt-specifikus példák
# =============================================================================

# === WiseProfi (trading platform) ===
# COVERAGE_THRESHOLD=95
# PYLINT_MIN_SCORE=9.0
# MAX_FILE_LINES=200
# SRC_DIR="src"
# STRICT_MODE=true

# === Gyors prototípus ===
# COVERAGE_THRESHOLD=80
# PYLINT_MIN_SCORE=8.0
# MAX_FILE_LINES=300
# SKIP_GIT=true

# === Legacy refactoring ===
# COVERAGE_THRESHOLD=70
# PYLINT_MIN_SCORE=7.0
# MAX_FILE_LINES=500
